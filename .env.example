# =============================================================================
# Quote Automation: environment variables
# Copy to .env.local and fill in. Never commit real values.
#
# Legend:  [always]  needed in every mode
#          [demo]    only used when DEMO_MODE=true
#          [real]    only needed when DEMO_MODE is off (ignored in demo mode)
# =============================================================================

# --- Demo mode ---------------------------------------------------------------
# [demo] "true" stubs Drive, Gmail and the PM API (nothing is uploaded or sent),
# forces the email gate to test mode, shows a banner, and replaces Google sign-in
# with an "Enter demo" button. Anything other than "true" = off.
DEMO_MODE=true
# [demo] Password of the demo@example.com user you create in Supabase Auth.
# Server-only; the browser never sees it.
DEMO_USER_PASSWORD=

# --- Supabase ----------------------------------------------------------------
# [always] Project Settings -> API. The anon key is public by design; the
# service-role key is a secret and is only ever read on the server.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Access ------------------------------------------------------------------
# [real] Comma-separated allowlist of emails permitted into the app. In demo mode
# demo@example.com is allowed automatically, so this can stay empty.
QUOTE_APP_ALLOWED_EMAILS=
# [real] Comma-separated emails allowed to add/remove SHARED send-as identities.
QUOTE_MASK_ADMINS=
# [always, optional] Fallback origin for the Google sign-in redirect when the
# request has no Origin header. Defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Drive (generated PDFs) -------------------------------------------
# [real] OAuth client + refresh token of the Google user that owns the folder,
# and the id of the Drive folder the PDFs are uploaded to.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
QUOTE_DRIVE_FOLDER_ID=

# --- Gmail (per-user "Connect Gmail", drafts + scheduled send) ----------------
# [real] Web OAuth client (redirect URI: <app origin>/api/gmail/callback).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# [real] 64 hex chars (32 bytes). Encrypts stored Gmail refresh tokens (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_TOKEN_KEY=

# --- Email safety gate (lib/quotes/email-safety.ts) ---------------------------
# [real] off (default: refuse to send) | test (ALL mail redirected to the test
# recipient) | live (real recipients, only if the second switch below is "true").
# Demo mode ignores both and always behaves as "test" with Gmail stubbed.
QUOTE_EMAIL_MODE=off
QUOTE_EMAIL_ALLOW_CUSTOMER_SEND=false
# [real] Shared secret the cron caller (scripts/email_queue_trigger.gs) sends in
# the x-email-queue-secret header to POST /api/email-queue/process.
EMAIL_QUEUE_SECRET=

# --- Project-management (PM) API ---------------------------------------------
# Internal names keep the original "SWIFT_" prefix.
# [real] Base URL of the upstream PM API used to verify a user's credentials.
SWIFT_BASE_URL=https://pm-api.example.com
# [real] 64 hex chars. Encrypts stored PM API passwords. Must differ from GMAIL_TOKEN_KEY.
SWIFT_CREDENTIAL_KEY=
